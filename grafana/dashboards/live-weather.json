{
  "uid": "live-weather",
  "title": "Live Weather (API \u2192 InfluxDB)",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "influxdb",
    "weather"
  ],
  "description": "Real observations polled by the API service: weatherapi.com if WEATHERAPI_KEY is set, otherwise Open-Meteo.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Temperature now",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"weather\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"api\" and r._field == \"temp_c\") |> group(columns: [\"location\"]) |> map(fn: (r) => ({_time: r._time, _value: r._value, location: r.location}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Wind now",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"weather\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"api\" and r._field == \"wind_kph\") |> group(columns: [\"location\"]) |> map(fn: (r) => ({_time: r._time, _value: r._value, location: r.location}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Temperature (\u00b0C)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"weather\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"api\" and r._field == \"temp_c\") |> group(columns: [\"location\"]) |> map(fn: (r) => ({_time: r._time, _value: r._value, location: r.location}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Wind (km/h)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"weather\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"api\" and r._field == \"wind_kph\") |> group(columns: [\"location\"]) |> map(fn: (r) => ({_time: r._time, _value: r._value, location: r.location}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
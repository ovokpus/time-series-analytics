# Copy to .env (gitignored). Every value has a working local default, so this is optional.
# Local-only credentials for the InfluxDB container (not for production).
INFLUX_TOKEN=local-dev-token
INFLUX_ORG=my-org
INFLUX_USER=my-user
INFLUX_PASSWORD=my-password
INFLUX_AIR_BUCKET=air-quality
INFLUX_WEATHER_BUCKET=weather

# Optional: weatherapi.com key (the original data source). Empty = keyless Open-Meteo.
WEATHERAPI_KEY=
WEATHER_CITY=Toronto
WEATHER_LAT=43.65
WEATHER_LON=-79.38
WEATHER_POLL_SECONDS=300

# Synthetic air-quality seed (used only when no real PRSA CSVs are in ./data)
SYNTH_STATIONS=Aotizhongxin,Wanliu,Dongsi
SYNTH_HOURS=720

INFLUX_PORT=8086
API_PORT=8000
GRAFANA_PORT=3000
FRONTEND_PORT=8080
